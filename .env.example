# Branding
NEXT_PUBLIC_SITE_NAME=Personality Reveal
NEXT_PUBLIC_SITE_URL=https://personalityreveal.com
NEXT_PUBLIC_CONTACT_EMAIL=info@studioradixs.nl
# Optional line in the footer, e.g. "Company BV · KvK 12345678 · Street 1, Amsterdam"
NEXT_PUBLIC_COMPANY_DETAILS=

# Legal notice / Impressum page (/[locale]/legal-notice). Use \n for line breaks in the address.
COMPANY_NAME=Studio Radixs
COMPANY_ADDRESS=Van Hogendorpstraat 54F
COMPANY_REPRESENTATIVE= K. Hoogendorp
COMPANY_REGISTRATION=KvK 93530552
COMPANY_VAT=NL005025270B57


# Report price in cents + currency
NEXT_PUBLIC_REPORT_PRICE_CENTS=395
NEXT_PUBLIC_REPORT_CURRENCY=eur

# Stripe (https://dashboard.stripe.com/apikeys). Without a key, local dev sends the report without payment.
STRIPE_SECRET_KEY=
# "true" = let Stripe Tax charge the correct EU VAT per country (activate Stripe Tax in the dashboard first)
STRIPE_AUTOMATIC_TAX=false
# Webhook endpoint: https://<your-domain>/api/stripe/webhook
# Events: checkout.session.completed, checkout.session.async_payment_succeeded
STRIPE_WEBHOOK_SECRET=

# SMTP for report and contact emails. Without SMTP_HOST emails are logged to the console.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Sender address (bare address, e.g. info@example.com). The display name comes from NEXT_PUBLIC_SITE_NAME.
CONTACT_FROM_EMAIL=

# Plausible analytics (cookieless). Goals: Test Start, Test Complete, Checkout Start, Purchase (with revenue)
# Google Analytics 4 measurement ID (G-XXXXXXX). Only loads after the visitor accepts the cookie banner.
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
# Optional: self-hosted script URL
NEXT_PUBLIC_PLAUSIBLE_SRC=

# Support: POST /api/admin/resend with "Authorization: Bearer <ADMIN_TOKEN>" (min. 16 characters)
ADMIN_TOKEN=

# Server errors are posted to this Slack/Discord/Teams webhook
ERROR_WEBHOOK_URL=
