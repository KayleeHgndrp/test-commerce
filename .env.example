# Branding
NEXT_PUBLIC_SITE_NAME=Testora
NEXT_PUBLIC_SITE_URL=https://www.example.com
NEXT_PUBLIC_CONTACT_EMAIL=support@example.com
# Optional line in the footer, e.g. "Company BV · KvK 12345678 · Street 1, Amsterdam"
NEXT_PUBLIC_COMPANY_DETAILS=

# Report price in cents + currency
NEXT_PUBLIC_REPORT_PRICE_CENTS=125
NEXT_PUBLIC_REPORT_CURRENCY=eur

# Stripe (https://dashboard.stripe.com/apikeys). Without a key, local dev sends the report without payment.
STRIPE_SECRET_KEY=
# Webhook endpoint: https://<your-domain>/api/stripe/webhook
# Events: checkout.session.completed, checkout.session.async_payment_succeeded
STRIPE_WEBHOOK_SECRET=

# Resend (https://resend.com) for report emails. Without a key emails are logged to the console.
RESEND_API_KEY=
EMAIL_FROM="Testora <reports@example.com>"
